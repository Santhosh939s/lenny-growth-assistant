# -----------------------------------------------------------------------------
# Lenny Growth Assistant - Environment Configuration Example
# Copy this file to .env or backend/.env and populate with your local values.
# NEVER commit real passwords, API keys, or credentials to version control.
# -----------------------------------------------------------------------------

# PostgreSQL Database Connection URL
# Local PostgreSQL: postgresql://<user>:<password>@localhost:5432/<dbname>
# Docker Compose:   postgresql://postgres:postgres@db:5432/lenny_assistant
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_assistant

# Path to the local clone of Lenny's Podcast Transcripts repository
# e.g., /path/to/lennys-podcast-transcripts or C:\path\to\lennys-podcast-transcripts
TRANSCRIPT_SOURCE_DIR=

# Active Model Provider: "ollama", "anthropic", or "openai"
MODEL_PROVIDER=ollama

# Local Ollama Configuration (Default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud Model Providers (Optional - only required if MODEL_PROVIDER is set to anthropic/openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLOUD_MODEL=claude-3-5-sonnet-20241022

# Environment
ENVIRONMENT=development
